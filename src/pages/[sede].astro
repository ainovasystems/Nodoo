---
// Página de cada sede. Es la URL que debe enlazarse desde su ficha de
// Google Business: mismo nombre, dirección y teléfono que en la ficha.
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import SpaceCard from '@/components/SpaceCard.astro';
import Faq from '@/components/Faq.astro';
import LeadForm from '@/components/LeadForm.astro';
import { ESPACIOS, FAQS, SEDES, SITE, type Sede } from '@/data/site';
import { breadcrumbSchema, faqSchema, sedeSchema } from '@/data/schema';

export function getStaticPaths() {
  return SEDES.map((sede) => ({ params: { sede: sede.slug }, props: { sede } }));
}

interface Props {
  sede: Sede;
}
const { sede } = Astro.props;
const site = Astro.site!;
const isCoruna = sede.id === 'coruna';
const other = SEDES.find((s) => s.id !== sede.id)!;

const faqs = isCoruna
  ? [
      {
        q: '¿Dónde está el coworking NODO en A Coruña?',
        a: `NODO Business Club A Coruña está en ${sede.street}, frente al puerto. La sede abre de ${sede.hours!.label}.`,
      },
      ...FAQS.filter((f) => /cuesta|permanencia|sala de reuniones|fotos|zonas comunes/i.test(f.q)),
    ]
  : [
      {
        q: '¿Dónde está el coworking NODO en Lugo?',
        a: `NODO Business Club Lugo está en ${sede.street}, Lugo.`,
      },
      {
        q: '¿Cómo puedo conocer la sede de Lugo?',
        a: `Escribe a ${SITE.email}, llama al ${SITE.phone} o envía el formulario de esta página y concertamos una visita.`,
      },
      {
        q: '¿NODO tiene más sedes en Galicia?',
        a: `Sí. Además de Lugo, NODO Business Club tiene sede en A Coruña, en ${other.street}.`,
      },
    ];

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: `Coworking en ${sede.city}`, path: `/${sede.slug}/` },
];
const description = isCoruna
  ? `Coworking en A Coruña frente al puerto: puestos desde 149 € + IVA/mes, sala de reuniones, oficina ejecutiva y estudio con vistas al mar. ${sede.street}.`
  : `Coworking en Lugo: la segunda sede de NODO Business Club, en ${sede.street}. Puestos de trabajo y salas de reuniones. Reserva una visita.`;
---

<Base title={`Coworking en ${sede.city} | NODO Business Club`} description={description} schema={[sedeSchema(site, sede), breadcrumbSchema(site, crumbs), faqSchema(faqs)]}>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li aria-current="page">Coworking en {sede.city}</li>
    </ol>
  </nav>

  <section class="page-hero">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <p class="page-hero__kind">Sede de NODO Business Club</p>
        <h1>Coworking en {sede.city}</h1>
        <p class="lead">{sede.intro}</p>
        <a class="btn btn--primary btn--lg" href="#visita">Reservar una visita</a>
      </div>
      <dl class="facts">
        <div><dt>Dirección</dt><dd>{sede.street}, {sede.locality}</dd></div>
        {sede.hours && <div><dt>Horario</dt><dd>{sede.hours.label}</dd></div>}
        <div><dt>Teléfono</dt><dd><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div><dt>Mapa</dt><dd><a class="text-link" href={sede.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a></dd></div>
      </dl>
    </div>
  </section>

  {
    isCoruna ? (
      <section class="section section--white">
        <div class="container">
          <div class="section__head">
            <h2>Espacios de la sede de A Coruña</h2>
            <p class="lead">
              Coworking, sala de reuniones, sala ejecutiva y estudio, todos en la misma planta y con zonas comunes incluidas.{' '}
              <a class="text-link" href="/#tarifas">Ver tarifas</a>.
            </p>
          </div>
          <div class="spaces">
            {ESPACIOS.map((e, i) => <SpaceCard espacio={e} wide={i < 2} />)}
          </div>
        </div>
      </section>
    ) : (
      <section class="section section--white">
        <div class="container split">
          <div class="section__head section__head--flush">
            <h2>NODO, ahora también en Lugo</h2>
            <p class="lead">
              Puestos de trabajo y salas para reunirte, con la misma forma de trabajar y la misma comunidad que en A Coruña.
            </p>
            <p>
              Escríbenos y te contamos qué espacios hay disponibles en la sede de Lugo, sus tarifas y cuándo puedes venir a conocerla.
            </p>
            <p><a class="text-link" href={`/${other.slug}/`}>Conoce también la sede de {other.city}</a></p>
          </div>
          <figure class="sede-photo">
            <Picture photo={ESPACIOS[0].photos[0]} sizes="(min-width: 900px) 560px, 100vw" />
            <figcaption>The Hive, en la sede de A Coruña.</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container faq-layout">
      <div class="section__head section__head--flush">
        <h2>Preguntas sobre la sede de {sede.city}</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <section class="section section--dark on-dark" id="visita">
    <div class="container contact">
      <div class="contact__aside">
        <div class="section__head section__head--flush">
          <h2>Visita la sede de {sede.city}</h2>
          <p class="lead">Cuéntanos qué necesitas y te respondemos para concretar día y hora.</p>
        </div>
        <dl class="contact__list">
          <div><dt>Dirección</dt><dd><a href={sede.mapsUrl} target="_blank" rel="noopener">{sede.street}, {sede.locality}</a></dd></div>
          <div><dt>Teléfono</dt><dd><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
      </div>
      <LeadForm sede={sede.id} id={`form-${sede.id}`} />
    </div>
  </section>
</Base>
