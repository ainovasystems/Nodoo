---
import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
---

<Base title={`Página no encontrada | ${SITE.name}`} description="La página que buscas no existe o ha cambiado de dirección." noindex>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li aria-current="page">Página no encontrada</li>
    </ol>
  </nav>

  <section class="section">
    <div class="container"><div class="prose">
      <h1>Esta página no existe</h1>
      <p class="lead">Puede que el enlace esté mal escrito o que la página haya cambiado de dirección.</p>
      <p class="cta-band__actions">
        <a class="btn btn--primary btn--lg" href="/">Ir al inicio</a>
        <a class="btn btn--ghost btn--lg" href="/#espacios">Ver los espacios</a>
      </p>
    </div></div>
  </section>
</Base>
