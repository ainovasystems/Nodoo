---
// Página contenedora de la demo de gestión. No se indexa.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · NODO Business Club</title>
    <link rel="icon" type="image/png" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/scanno" media="print" onload="this.media='all'" />
  </head>
  <body>
    <slot />
  </body>
</html>
