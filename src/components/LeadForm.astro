---
// Formulario de contacto. Sin servidor todavía: al enviar se abre un correo
// ya redactado para info@nodobc.com (así ninguna solicitud se pierde) y,
// además, el contacto se deja en la bandeja de la demo para que aparezca
// como lead nuevo en el panel interno.
import { SEDES, SITE } from '@/data/site';

interface Props {
  /** Sede preseleccionada en las páginas de sede. */
  sede?: string;
  id?: string;
}
const { sede, id = 'form-contacto' } = Astro.props;
const interests = ['Puesto de coworking', 'Sala de reuniones', 'Oficina The Office', 'Atlantic Studio', 'Otra consulta'];
---

<form class="form" id={id} novalidate data-lead-form data-email={SITE.email}>
  <div class="form__row">
    <div class="form-field">
      <label for={`${id}-nombre`}>Nombre y apellidos</label>
      <input id={`${id}-nombre`} name="name" type="text" autocomplete="name" required />
      <p class="form-field__error" hidden></p>
    </div>
    <div class="form-field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      <p class="form-field__error" hidden></p>
    </div>
  </div>
  <div class="form__row">
    <div class="form-field">
      <label for={`${id}-tel`}>Teléfono <span class="optional">(opcional)</span></label>
      <input id={`${id}-tel`} name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="form-field">
      <label for={`${id}-empresa`}>Empresa <span class="optional">(opcional)</span></label>
      <input id={`${id}-empresa`} name="company" type="text" autocomplete="organization" />
    </div>
  </div>
  <div class="form__row">
    <div class="form-field">
      <label for={`${id}-sede`}>Sede</label>
      <select id={`${id}-sede`} name="sede" required>
        {SEDES.map((s) => <option value={s.id} selected={s.id === sede}>{s.city}</option>)}
      </select>
    </div>
    <div class="form-field">
      <label for={`${id}-interes`}>Qué necesitas</label>
      <select id={`${id}-interes`} name="interest" required>
        {interests.map((i) => <option>{i}</option>)}
      </select>
    </div>
  </div>
  <div class="form-field">
    <label for={`${id}-mensaje`}>Mensaje <span class="optional">(opcional)</span></label>
    <textarea id={`${id}-mensaje`} name="message" rows="4"></textarea>
  </div>
  <div class="form__hp" aria-hidden="true">
    <label for={`${id}-web`}>No rellenes este campo</label>
    <input id={`${id}-web`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="form-field">
    <label class="form-check">
      <input name="consent" type="checkbox" required />
      <span>He leído la <a class="text-link" href="/legal/privacidad/">política de privacidad</a> y acepto que NODO use mis datos para responder a esta solicitud.</span>
    </label>
    <p class="form-field__error" hidden></p>
  </div>
  <button class="btn btn--primary btn--lg" type="submit">Enviar solicitud</button>
  <p class="form__status" role="status" hidden></p>
  <p class="form__legal">
    Responsable: {SITE.name}. Finalidad: atender tu solicitud. Base legal: tu consentimiento. Puedes ejercer tus derechos
    escribiendo a {SITE.email}.
  </p>
</form>

<script>
  const INBOX = 'nodo-demo-lead-inbox';
  const VALUES: Record<string, number> = {
    'Puesto de coworking': 149,
    'Sala de reuniones': 80,
    'Oficina The Office': 2475,
    'Atlantic Studio': 190,
  };
  const MESSAGES: Record<string, string> = {
    name: 'Escribe tu nombre.',
    email: 'Escribe un email válido, por ejemplo nombre@empresa.com.',
    consent: 'Marca la casilla para poder responderte.',
  };

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status')!;

    const showError = (input: HTMLInputElement, message: string | null) => {
      const error = input.closest('.form-field')?.querySelector<HTMLElement>('.form-field__error');
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) {
        error.textContent = message ?? '';
        error.hidden = !message;
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.hidden = true;
      const data = new FormData(form);
      if (data.get('website')) return; // trampa para bots

      let firstInvalid: HTMLInputElement | null = null;
      for (const name of ['name', 'email', 'consent']) {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const valid = input.checkValidity();
        showError(input, valid ? null : MESSAGES[name]);
        if (!valid && !firstInvalid) firstInvalid = input;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const sedeSelect = form.elements.namedItem('sede') as HTMLSelectElement;
      const sedeName = sedeSelect.selectedOptions[0].textContent ?? '';
      const interest = String(data.get('interest'));
      const lead = {
        id: `l-web-${Date.now().toString(36)}`,
        name: String(data.get('name')).trim(),
        email: String(data.get('email')).trim(),
        phone: String(data.get('phone') ?? '').trim(),
        company: String(data.get('company') ?? '').trim(),
        sedeId: sedeSelect.value,
        interest,
        source: 'Web',
        stage: 'nuevo',
        value: VALUES[interest] ?? 0,
        owner: 'Sin asignar',
        createdAt: new Date().toISOString(),
        nextAction: null,
        notes: [],
        message: String(data.get('message') ?? '').trim() || undefined,
      };

      // Demo: el contacto aparece como lead nuevo en el panel interno.
      try {
        const inbox = JSON.parse(localStorage.getItem(INBOX) ?? '[]');
        inbox.unshift(lead);
        localStorage.setItem(INBOX, JSON.stringify(inbox));
      } catch {
        // Sin almacenamiento local: el correo sigue saliendo.
      }

      const lines = [`Nombre: ${lead.name}`, `Email: ${lead.email}`];
      if (lead.phone) lines.push(`Teléfono: ${lead.phone}`);
      if (lead.company) lines.push(`Empresa: ${lead.company}`);
      lines.push(`Sede: ${sedeName}`, `Interés: ${lead.interest}`);
      if (lead.message) lines.push('', lead.message);
      const body = lines.join('\n');
      const mailto = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Solicitud web · ${lead.interest} · ${sedeName}`)}&body=${encodeURIComponent(body)}`;

      status.innerHTML = `Solicitud preparada. Se abrirá tu aplicación de correo con el mensaje ya escrito: envíalo para que llegue al equipo de NODO. Si no se abre, <a class="text-link" href="${mailto}">pulsa aquí</a>.`;
      status.hidden = false;
      form.reset();
      window.location.href = mailto;
    });

    form.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.getAttribute('aria-invalid') === 'true' && input.checkValidity()) showError(input, null);
    });
  });
</script>
